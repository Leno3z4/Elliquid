# Copy to contracts/.env and keep the real file out of Git.
# Elysium Testnet: chain ID 99801, RPC https://testnet-rpc.elysium.kinetiq.xyz
OWNER=0xYOUR_GOVERNANCE_WALLET
# Use a separate key/wallet from OWNER. It may pause, but cannot unpause or change pool policy.
PAUSE_GUARDIAN=0xYOUR_EMERGENCY_PAUSE_WALLET
DEFAULT_FEE_BPS=30

# Do not put the real deployer key in this example file.
# Supply it to Foundry as an environment variable when you execute the script:
# export DEPLOYER_PRIVATE_KEY=...

# Fill this after factory deployment, before deploying the router.
POOL_FACTORY=0xYOUR_DEPLOYED_FACTORY_ADDRESS
