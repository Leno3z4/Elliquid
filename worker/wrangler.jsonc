{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elliquid-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ELYSIUM_RPC_URL": "https://testnet-rpc.elysium.kinetiq.xyz",
    "MIN_REQUEST_DURATION_SECONDS": "3600",
    "MAX_REQUEST_DURATION_SECONDS": "2592000",
    "MAX_INVENTORY_BPS": "10000",
    "MAX_LIQUIDITY_FEE_BPS": "1000",
    "RECONCILE_BATCH_SIZE": "4"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elliquid-db",
      "database_id": "bc4ca6a9-9ba5-4283-bed2-3baff1bb13ea",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "91001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "91002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "limits": {
    "subrequests": 40
  },
  "triggers": {
    "crons": ["*/1 * * * *"]
  }
}
