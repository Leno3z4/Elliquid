# Next.js frontend
NEXT_PUBLIC_ELLIQUID_API_URL=https://YOUR-WORKER.example.workers.dev
# Optional: a dedicated Elysium Testnet RPC improves frontend read reliability.
# The Alchemy API key is browser-visible because NEXT_PUBLIC values are bundled into the app.
NEXT_PUBLIC_ELYSIUM_RPC_URL=https://elysium-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Native Elliquid AMM (Elysium Testnet only until audited)
NEXT_PUBLIC_ELLIQUID_POOL_FACTORY_ADDRESS=
NEXT_PUBLIC_ELLIQUID_ROUTER_ADDRESS=
